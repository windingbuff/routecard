# Node 20: source these in your shell; the app does not auto-load .env
KITE_MODE=local
KITE_NETWORK=kite-testnet
PORT=3000
HOST=127.0.0.1
# For paid mode, configure all of these with verified values:
# PUBLIC_ORIGIN=https://your-service.example
# KITE_PAY_TO=
# KITE_ASSET=
# KITE_TOKEN_NAME=
# KITE_TOKEN_VERSION=
# KITE_AMOUNT=10000
# KITE_DATA_DIR=/persistent/private/service-ledger
# KITE_STORAGE_KEY=
# KITE_LIVE_ACK=I_HAVE_VERIFIED_ASSET_AND_FACILITATOR

# Project inputs, versions and reviews persist here in BOTH modes.
WORKSPACE_DATA_DIR=.workspace-data
# Required for remote or paid-mode project management; at least 32 characters.
# WORKSPACE_ACCESS_TOKEN=

